
Project Cinema {
  database_type: 'MySQL'
  Note: 'Cinema booking system with Mystery Cinema'
}

// ============================================
// 1. ACCOUNTS AND CUSTOMERS
// ============================================

Table login {
  login_id int [pk, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, default: 'customer']
  is_active boolean [not null, default: true]
  last_login datetime
  created_at datetime [not null]

  indexes {
    role
  }
}

Table customers {
  customer_id int [pk, increment]
  login_id int [not null, unique]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(150) [not null, unique]
  phone varchar(30)
  created_at datetime [not null]
}

// ============================================
// 2. MOVIES AND GENRES
// ============================================

Table genres {
  genre_id int [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table movies {
  movie_id int [pk, increment]
  title varchar(150) [not null]
  description text
  duration_minutes int [not null]
  release_date date
  age_rating varchar(10)
  language varchar(50)
  poster_url varchar(500)
  is_active boolean [not null, default: true]
  created_at datetime [not null]

  indexes {
    (is_active, title)
  }
}

Table movie_genres {
  movie_id int [not null]
  genre_id int [not null]

  indexes {
    (movie_id, genre_id) [pk]
    (genre_id, movie_id)
  }
}

// ============================================
// 3. HALLS AND SEATS
// ============================================

Table halls {
  hall_id int [pk, increment]
  hall_name varchar(50) [not null, unique]
  is_mystery_hall boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at datetime [not null]
}

Table seats {
  seat_id int [pk, increment]
  hall_id int [not null]
  row_number varchar(5) [not null]
  seat_number int [not null]
  seat_type varchar(20) [not null, default: 'standard']
  is_active boolean [not null, default: true]

  indexes {
    (hall_id, row_number, seat_number) [unique]
    (seat_id, hall_id) [unique]
  }
}

// ============================================
// 4. SCREENINGS
// ============================================

Table screenings {
  screening_id int [pk, increment]
  movie_id int
  hall_id int [not null]
  start_time datetime [not null]
  end_time datetime [not null]
  screening_type varchar(20) [not null, default: 'regular']
  status varchar(20) [not null, default: 'scheduled']
  ticket_price decimal(8,2) [not null]
  created_at datetime [not null]

  indexes {
    (status, start_time)
    (hall_id, start_time, end_time)
    (movie_id, start_time)
    (screening_id, hall_id) [unique]
  }
}

// ============================================
// 5. BOOKINGS
// ============================================

Table bookings {
  booking_id int [pk, increment]
  customer_id int [not null]
  screening_id int [not null]
  booking_status varchar(20) [not null, default: 'pending']
  booking_date datetime [not null]
  total_amount decimal(8,2) [not null]
  confirmed_at datetime
  cancelled_at datetime

  indexes {
    (customer_id, booking_date)
    (screening_id, booking_status)
    (booking_id, screening_id) [unique]
  }
}

// Historical record of seats associated with a booking.
// Records are retained when a booking is cancelled.

Table booking_seats {
  booking_seat_id int [pk, increment]
  booking_id int [not null]
  screening_id int [not null]
  hall_id int [not null]
  seat_id int [not null]
  seat_price decimal(8,2) [not null]

  indexes {
    (booking_id, seat_id) [unique]
    (screening_id, seat_id)
  }
}

// Contains only currently held or booked seats.
// A seat is released by removing its active reservation
// within the same transaction that cancels the booking.

Table active_seat_reservations {
  screening_id int [not null]
  hall_id int [not null]
  seat_id int [not null]
  booking_id int [not null]
  reserved_at datetime [not null]
  expires_at datetime

  indexes {
    (screening_id, seat_id) [pk]
    (booking_id, seat_id) [unique]
    booking_id
    expires_at
  }
}

// ============================================
// 6. MYSTERY CINEMA PREFERENCES
// ============================================

Table mystery_preferences {
  preference_id int [pk, increment]
  booking_id int [not null, unique]
  genre_id int [not null]
  created_at datetime [not null]
}

Table mystery_preference_movies {
  preference_id int [not null]
  position int [not null]
  movie_id int [not null]

  indexes {
    (preference_id, position) [pk]
    (preference_id, movie_id) [unique]
    movie_id
  }
}

// ============================================
// 7. MYSTERY CINEMA GROUPS
// ============================================

// One Mystery group per Mystery screening.
// The selected movie is stored in screenings.movie_id.
// It may remain NULL until the mystery movie is revealed.

Table mystery_groups {
  group_id int [pk, increment]
  screening_id int [not null, unique]
  genre_id int [not null]
  group_status varchar(20) [not null, default: 'forming']
  created_at datetime [not null]
}

Table mystery_group_members {
  group_id int [not null]
  booking_id int [not null]
  match_score decimal(5,2)
  joined_at datetime [not null]

  indexes {
    (group_id, booking_id) [pk]
    (booking_id) [unique]
  }
}

// ============================================
// 8. PAYMENTS
// ============================================

Table payments {
  payment_id int [pk, increment]
  booking_id int [not null]
  amount decimal(8,2) [not null]
  currency char(3) [not null, default: 'EUR']
  payment_method varchar(30) [not null]
  payment_status varchar(20) [not null, default: 'pending']
  transaction_reference varchar(100) [unique]
  created_at datetime [not null]
  paid_at datetime

  indexes {
    (booking_id, created_at)
    (payment_status, created_at)
  }
}

// ============================================
// 9. BOOKING STATUS AUDIT
// ============================================

Table booking_status_history {
  history_id int [pk, increment]
  booking_id int [not null]
  old_status varchar(20) [not null]
  new_status varchar(20) [not null]
  changed_at datetime [not null]
  changed_by_login_id int
}

// ============================================
// RELATIONSHIPS
// ============================================

Ref: customers.login_id - login.login_id

Ref: movie_genres.movie_id > movies.movie_id
Ref: movie_genres.genre_id > genres.genre_id

Ref: seats.hall_id > halls.hall_id

Ref: screenings.movie_id > movies.movie_id
Ref: screenings.hall_id > halls.hall_id

Ref: bookings.customer_id > customers.customer_id
Ref: bookings.screening_id > screenings.screening_id

Ref: booking_seats.(booking_id, screening_id) >
     bookings.(booking_id, screening_id)

Ref: booking_seats.(screening_id, hall_id) >
     screenings.(screening_id, hall_id)

Ref: booking_seats.(seat_id, hall_id) >
     seats.(seat_id, hall_id)

Ref: active_seat_reservations.(booking_id, screening_id) >
     bookings.(booking_id, screening_id)

Ref: active_seat_reservations.(screening_id, hall_id) >
     screenings.(screening_id, hall_id)

Ref: active_seat_reservations.(seat_id, hall_id) >
     seats.(seat_id, hall_id)

Ref: mystery_preferences.booking_id - bookings.booking_id
Ref: mystery_preferences.genre_id > genres.genre_id

Ref: mystery_preference_movies.preference_id >
     mystery_preferences.preference_id

Ref: mystery_preference_movies.movie_id > movies.movie_id

Ref: mystery_groups.screening_id - screenings.screening_id
Ref: mystery_groups.genre_id > genres.genre_id

Ref: mystery_group_members.group_id > mystery_groups.group_id
Ref: mystery_group_members.booking_id - bookings.booking_id

Ref: payments.booking_id > bookings.booking_id

Ref: booking_status_history.booking_id > bookings.booking_id
Ref: booking_status_history.changed_by_login_id > login.login_id
